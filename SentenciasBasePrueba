SQL> CREATE TABLE Gastos (
  2  Id_gasto NUMBER(10) CONSTRAINT gas_id_pk PRIMARY KEY,
  3  Articulo VARCHAR(100) CONSTRAINT gas_art_nn NOT NULL,
  4  Cantidad NUMBER(10,2) CONSTRAINT gas_can_nn NOT NULL
  5  CONSTRAINT gas_can_ck CHECK (Cantidad > 0),
  6  Valor_producto NUMBER(12,2) CONSTRAINT gas_val_nn NOT NULL
  7  CONSTRAINT gas_val_ck CHECK (Valor_producto >= 0),
  8  Fecha_registro DATE CONSTRAINT gas_fre_nn NOT NULL,
  9  Estado VARCHAR(20) DEFAULT 'REGISTRADO' CONSTRAINT gas_est_nn NOT NULL
 10  CONSTRAINT gas_est_ck CHECK (Estado IN ('REGISTRADO','CORREGIDO','CON_INCONSISTENCIA','VALIDADO')),
 11  Id_hogar NUMBER(10) CONSTRAINT gas_hog_nn NOT NULL CONSTRAINT gas_hog_fk REFERENCES Hogar(Id_hogar),
 12  Id_encuestado VARCHAR(20) CONSTRAINT gas_enc_nn NOT NULL CONSTRAINT gas_enc_fk REFERENCES Encuestado(Documento),
 13  Id_lugar NUMBER(10) CONSTRAINT gas_lug_fk REFERENCES Lugar_Compra(Id_lugar),
 14  Id_forma NUMBER(10) CONSTRAINT gas_for_nn NOT NULL CONSTRAINT gas_for_fk REFERENCES Forma_Adquisicion(Id_forma),
 15  Id_tipo NUMBER(10) CONSTRAINT gas_tip_nn NOT NULL CONSTRAINT gas_tip_fk REFERENCES Tipo_Gasto(Id_tipo),
 16  Id_unidad NUMBER(10) CONSTRAINT gas_uni_nn NOT NULL CONSTRAINT gas_uni_fk REFERENCES Unidad_Medida(Id_unidad),
 17  Id_frecuencia NUMBER(10) CONSTRAINT gas_fcu_nn NOT NULL CONSTRAINT gas_fcu_fk REFERENCES Frecuencia_Compra(Id_frecuencia),
 18  Documento_recolector NUMBER(10) CONSTRAINT gas_rcl_fk REFERENCES Recolector(Documento),
 19  Fecha_modificacion DATE,
 20  Modificacion VARCHAR(200),
 21  CONSTRAINT gas_cor_ck CHECK ((Documento_recolector IS NULL AND Fecha_modificacion IS NULL AND Modificacion IS NULL)
 22  OR (Documento_recolector IS NOT NULL AND Fecha_modificacion IS NOT NULL AND Modificacion IS NOT NULL)),
 23  CONSTRAINT gas_mod_ck CHECK (Fecha_modificacion IS NULL OR Fecha_modificacion >= Fecha_registro)
 24  );

