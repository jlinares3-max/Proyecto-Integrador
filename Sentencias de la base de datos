-- ---------------------------------------------------------------------
-- UBICACION
-- ---------------------------------------------------------------------

CREATE TABLE Departamento (
Id_departamento NUMBER(10) CONSTRAINT dep_id_pk PRIMARY KEY,
Nombre VARCHAR(60) CONSTRAINT dep_nom_nn NOT NULL
);

CREATE TABLE Municipio (
Id_municipio NUMBER(10) CONSTRAINT mun_id_pk PRIMARY KEY,
Nombre VARCHAR(60) CONSTRAINT mun_nom_nn NOT NULL,
Id_departamento NUMBER(10) CONSTRAINT mun_dep_fk REFERENCES Departamento(Id_departamento)
);

CREATE TABLE Barrio (
Id_barrio NUMBER(10) CONSTRAINT bar_id_pk PRIMARY KEY,
Nombre VARCHAR(60) CONSTRAINT bar_nom_nn NOT NULL,
Id_municipio NUMBER CONSTRAINT bar_mun_fk REFERENCES Municipio(Id_municipio)
);

-- ---------------------------------------------------------------------
-- USUARIO Y PERSONAL DE CAMPO
-- ---------------------------------------------------------------------
CREATE TABLE Usuario (
Usuario VARCHAR(30) CONSTRAINT usu_usu_pk PRIMARY KEY,
Clave VARCHAR(100) CONSTRAINT usu_cla_nn NOT NULL, 
Rol VARCHAR(20) CONSTRAINT usu_rol_nn NOT NULL,
Fecha_creacion DATE CONSTRAINT usu_fec_nn NOT NULL
);

CREATE TABLE Supervisor (
Id_supervisor NUMBER(20) CONSTRAINT sup_id_pk PRIMARY KEY,
Documento VARCHAR(20) CONSTRAINT sup_doc_nn NOT NULL
CONSTRAINT sup_doc_uk UNIQUE,
Nombre_completo VARCHAR(100) CONSTRAINT sup_nom_nn NOT NULL,
Vigencia VARCHAR(2) CONSTRAINT sup_vig_nn NOT NULL,
Fecha_nacimiento DATE CONSTRAINT sup_fec_nn NOT NULL,
Id_usuario VARCHAR(30) CONSTRAINT sup_usu_fk REFERENCES Usuario(Usuario)
);

CREATE TABLE Recolector (
Id_recolector NUMBER(20) CONSTRAINT rcl_id_pk PRIMARY KEY,
Documento VARCHAR(20) CONSTRAINT rcl_doc_nn NOT NULL
CONSTRAINT rcl_doc_uk UNIQUE,
Credencial VARCHAR(20) CONSTRAINT rcl_cre_nn NOT NULL
CONSTRAINT rcl_cre_uk UNIQUE,
Nombre_completo VARCHAR(100) CONSTRAINT rcl_nom_nn NOT NULL,
Vigencia VARCHAR(2) CONSTRAINT rcl_vig_nn NOT NULL,
Fecha_nacimiento DATE CONSTRAINT rcl_fec_nn NOT NULL,
Id_supervisor NUMBER(20) CONSTRAINT rcl_sup_nn NOT NULL
CONSTRAINT rcl_sup_fk REFERENCES Supervisor(Id_supervisor),
Id_usuario VARCHAR(30) CONSTRAINT rcl_usu_uk UNIQUE
CONSTRAINT rcl_usu_fk REFERENCES Usuario(Usuario)
);

CREATE TABLE Recuentista (
Id_recuentista NUMBER(10) CONSTRAINT rct_id_pk PRIMARY KEY,
Documento VARCHAR(20) CONSTRAINT rct_doc_nn NOT NULL
CONSTRAINT rct_doc_uk UNIQUE,
Nombre_completo VARCHAR(100) CONSTRAINT rct_nom_nn NOT NULL,
Vigencia VARCHAR(2) CONSTRAINT rct_vig_nn NOT NULL,
Fecha_nacimiento DATE CONSTRAINT rct_fec_nn NOT NULL
);

-- ---------------------------------------------------------------------
-- VIVIENDA Y HOGAR
-- ---------------------------------------------------------------------
CREATE TABLE Vivienda (
Id_vivienda NUMBER(10) CONSTRAINT viv_id_pk PRIMARY KEY,
Cant_hogares NUMBER(10) CONSTRAINT viv_can_nn NOT NULL,
Fecha_reconocimiento DATE CONSTRAINT viv_fec_nn NOT NULL,
Estado VARCHAR(20) CONSTRAINT viv_est_nn NOT NULL, -- definir valores permitidos
Direccion VARCHAR(150) CONSTRAINT viv_dir_nn NOT NULL,
Num_vivienda NUMBER(20) CONSTRAINT viv_num_nn NOT NULL,
Id_barrio NUMBER(10) CONSTRAINT viv_bar_nn NOT NULL
CONSTRAINT viv_bar_fk REFERENCES Barrio(Id_barrio),
Id_recuentista NUMBER(10) CONSTRAINT viv_rct_nn NOT NULL
CONSTRAINT viv_rct_fk REFERENCES Recuentista(Id_recuentista)
);

CREATE TABLE Hogar (
Id_hogar NUMBER(10) CONSTRAINT hog_id_pk PRIMARY KEY,
Num_hogar NUMBER(10) CONSTRAINT hog_num_nn NOT NULL,
Telefono VARCHAR(15) CONSTRAINT hog_tel_nn NOT NULL, 
Total_personas NUMBER CONSTRAINT hog_tot_nn NOT NULL
CONSTRAINT hog_tot_ck CHECK (Total_personas > 0),
Fecha_apertura DATE CONSTRAINT hog_fap_nn NOT NULL,
Estado_ciclo VARCHAR(20) CONSTRAINT hog_est_nn NOT NULL, 
Codigo_encuesta VARCHAR(20) CONSTRAINT hog_cod_nn NOT NULL
CONSTRAINT hog_cod_uk UNIQUE,
Id_vivienda NUMBER(10) CONSTRAINT hog_viv_nn NOT NULL
CONSTRAINT hog_viv_fk REFERENCES Vivienda(Id_vivienda),
Id_recolector NUMBER CONSTRAINT hog_rcl_fk REFERENCES Recolector(Id_recolector),
Fecha_asignacion DATE
);

-- ---------------------------------------------------------------------
-- DISPOSITIVO Y ENCUESTADO
-- ---------------------------------------------------------------------
CREATE TABLE Dispositivo (
Id_dispositivo NUMBER(10) CONSTRAINT dis_id_pk PRIMARY KEY,
Estado VARCHAR(20) CONSTRAINT dis_est_nn NOT NULL 
);

CREATE TABLE Encuestado (
Id_encuestado NUMBER(20) CONSTRAINT enc_id_pk PRIMARY KEY,
Documento VARCHAR(20) CONSTRAINT enc_doc_nn NOT NULL
CONSTRAINT enc_doc_uk UNIQUE,
Nombre_completo VARCHAR(150) CONSTRAINT enc_nom_nn NOT NULL,
Celular VARCHAR(15) CONSTRAINT enc_cel_nn NOT NULL,
Parentesco VARCHAR(30) CONSTRAINT enc_par_nn NOT NULL,
Correo VARCHAR(100),
Id_dispositivo NUMBER(10) CONSTRAINT enc_dis_nn NOT NULL
CONSTRAINT enc_dis_fk REFERENCES Dispositivo(Id_dispositivo),
Id_usuario VARCHAR(30) CONSTRAINT enc_usu_nn NOT NULL
CONSTRAINT enc_usu_fk REFERENCES Usuario(Usuario),
Id_hogar NUMBER(10) CONSTRAINT enc_hog_nn NOT NULL
CONSTRAINT enc_hog_fk REFERENCES Hogar(Id_hogar),
Id_recolector NUMBER(20) CONSTRAINT enc_rcl_nn NOT NULL
CONSTRAINT enc_rcl_fk REFERENCES Recolector(Id_recolector),
Fecha_entrega DATE CONSTRAINT enc_fen_nn NOT NULL,
Fecha_recogida DATE
);

-- ---------------------------------------------------------------------
-- GASTOS
-- ---------------------------------------------------------------------
CREATE TABLE Lugar_Compra (
Id_lugar NUMBER(20) CONSTRAINT lug_id_pk PRIMARY KEY,
Nombre VARCHAR(80) CONSTRAINT lug_nom_nn NOT NULL
);

CREATE TABLE Gastos (
Id_gasto NUMBER(20) CONSTRAINT gas_id_pk PRIMARY KEY,
Articulo VARCHAR(100) CONSTRAINT gas_art_nn NOT NULL,
Cantidad NUMBER(10,2) CONSTRAINT gas_can_nn NOT NULL
CONSTRAINT gas_can_ck CHECK (Cantidad > 0),
Valor NUMBER(12,2) CONSTRAINT gas_val_nn NOT NULL
CONSTRAINT gas_val_ck CHECK (Valor >= 0),
Equivalencia NUMBER(10,2),
Frecuencia_compra VARCHAR(15) CONSTRAINT gas_fre_nn NOT NULL
CONSTRAINT gas_fre_ck CHECK (Frecuencia_compra IN ('DIARIO','VARIAS_SEMANA','SEMANAL',
'QUINCENAL','MENSUAL','BIMESTRAL','TRIMESTRAL','ESPORADICA')),
Fecha_registro DATE CONSTRAINT gas_fre2_nn NOT NULL,
Tipo_gasto VARCHAR(10) CONSTRAINT gas_tip_nn NOT NULL
CONSTRAINT gas_tip_ck CHECK (Tipo_gasto IN ('HOGAR','PERSONAL')),
Forma_adquisicion VARCHAR(20) CONSTRAINT gas_for_nn NOT NULL
CONSTRAINT gas_for_ck CHECK (Forma_adquisicion IN ('COMPRA','PAGO_TRABAJO','REGALO',
'TRUEQUE','PRODUCIDO_HOGAR','NEGOCIO_HOGAR','OTRA')),
Estado VARCHAR(20) CONSTRAINT gas_est_nn NOT NULL, 
Und_medida VARCHAR(15) CONSTRAINT gas_und_nn NOT NULL
CONSTRAINT gas_und_ck CHECK (Und_medida IN ('CM3','LITRO','GRAMO','ONZA','LIBRA',
'KILOGRAMO','ARROBA','OTRA')),
Id_recolector NUMBER(20) CONSTRAINT gas_rcl_fk REFERENCES Recolector(Id_recolector),
Fecha_modificacion DATE,
Id_encuestado NUMBER(20) CONSTRAINT gas_enc_nn NOT NULL
CONSTRAINT gas_enc_fk REFERENCES Encuestado(Id_encuestado),
Id_lugar NUMBER(20) CONSTRAINT gas_lug_fk REFERENCES Lugar_Compra(Id_lugar),
CONSTRAINT gas_lug_ck CHECK ((Forma_adquisicion = 'COMPRA' AND Id_lugar IS NOT NULL)
OR (Forma_adquisicion <> 'COMPRA' AND Id_lugar IS NULL)),
CONSTRAINT gas_equ2_ck CHECK (Und_medida <> 'OTRA' OR Equivalencia IS NOT NULL),
CONSTRAINT gas_mod_ck CHECK (Fecha_modificacion IS NULL OR Fecha_modificacion >= Fecha_registro)
);

-- ---------------------------------------------------------------------
-- SEGUIMIENTO: VISITA Y NOVEDAD
-- ---------------------------------------------------------------------
CREATE TABLE Visita (
Id_visita NUMBER(20) CONSTRAINT vis_id_pk PRIMARY KEY,
Fechahora_visita DATE CONSTRAINT vis_fec_nn NOT NULL,
Num_visita NUMBER(10) CONSTRAINT vis_num_nn NOT NULL,
Tipo_visita VARCHAR(20) CONSTRAINT vis_tip_nn NOT NULL, 
Prox_visita DATE,
Observaciones VARCHAR(500),
Dias_revisados NUMBER CONSTRAINT vis_dia_nn NOT NULL
CONSTRAINT vis_dia_ck CHECK (Dias_revisados BETWEEN 0 AND 14),
Cap_en_curso VARCHAR(20) CONSTRAINT vis_cap_nn NOT NULL,
Resultado VARCHAR(30) CONSTRAINT vis_res_nn NOT NULL,
Id_hogar NUMBER(20) CONSTRAINT vis_hog_nn NOT NULL
CONSTRAINT vis_hog_fk REFERENCES Hogar(Id_hogar),
Id_recolector NUMBER CONSTRAINT vis_rcl_nn NOT NULL
CONSTRAINT vis_rcl_fk REFERENCES Recolector(Id_recolector),
CONSTRAINT vis_pro_ck CHECK (Prox_visita IS NULL OR Prox_visita > Fechahora_visita)
);

CREATE TABLE Novedad (
Id_novedad NUMBER(20) CONSTRAINT nov_id_pk PRIMARY KEY,
Tipo_novedad VARCHAR(30) CONSTRAINT nov_tip_nn NOT NULL, 
Descripcion VARCHAR(500) CONSTRAINT nov_des_nn NOT NULL,
Fecha DATE CONSTRAINT nov_fec_nn NOT NULL,
Id_supervisor NUMBER(20) CONSTRAINT nov_sup_nn NOT NULL
CONSTRAINT nov_sup_fk REFERENCES Supervisor(Id_supervisor),
Id_visita NUMBER(20) CONSTRAINT nov_vis_nn NOT NULL
CONSTRAINT nov_vis_fk REFERENCES Visita(Id_visita)
);

